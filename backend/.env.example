# ─── JWT / AUTH ───────────────────────────────────────────
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=24

# ─── DATABASE: maestro (canal de escritura) ────────────────
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_MASTER_HOST=127.0.0.1
DB_MASTER_PORT=5432

# ─── DATABASE: réplica de lectura ──────────────────────────
# Mantener False en desarrollo sin réplica. Al activar True, DB_REPLICA_HOST
# es obligatorio y debe ser una IP/DNS diferente al maestro.
DB_REPLICA_ENABLED=False
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432

# Pool psycopg por proceso del backend. La réplica recibe más SELECT analíticos.
DB_WRITE_POOL_MIN_SIZE=1
DB_WRITE_POOL_MAX_SIZE=5
DB_READ_POOL_MIN_SIZE=2
DB_READ_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10

# ─── APP ──────────────────────────────────────────────────
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
